# Copy this file to .env.local and fill in your values
# .env.local is gitignored and won't be committed

# Anthropic API key for the AI chat assistant (primary)
# Get yours at https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Server-side key for api/*.js functions (brief-chat, gatekeeper-chat). Vercel: set in project env.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key — used as fallback when Anthropic credits run out
# Get yours at https://platform.openai.com/
VITE_OPENAI_API_KEY=sk-proj-...

# Server-side OpenAI key for api/gatekeeper-chat.js. If set, gatekeeper uses GPT instead of Claude.
OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o

# Telegram bot (tools/gatekeeper_bot.mjs). Token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC...

# YouTrack (optional, /task command in the Telegram bot)
YOUTRACK_URL=https://yourcompany.youtrack.cloud
YOUTRACK_TOKEN=perm:...
YOUTRACK_PROJECT=DSP
