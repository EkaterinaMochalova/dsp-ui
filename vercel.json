{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/brief-chat", "destination": "/api/brief-chat" },
    { "source": "/api/:path*", "destination": "/api/proxy" },
    { "source": "/((?!planner/).*)", "destination": "/index.html" }
  ]
}
